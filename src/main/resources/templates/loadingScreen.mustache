<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>홈</title>
    <style>
        body, html {
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            font-family: Arial, sans-serif;
        }

        .loading-container {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .spinner {
            width: 70px;
            height: 70px;
            border: 10px solid transparent;
            border-top: 10px solid #4380d5;
            border-radius: 100%;
            animation: spin 1.5s ease-in-out infinite;
            position: relative;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        }

        .spinner::after {
            content: "";
            position: absolute;
            top: 8px;
            left: 8px;
            width: 54px;
            height: 54px;
            background: radial-gradient(circle, rgba(52, 152, 219, 0.3), transparent);
            border-radius: 50%;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        @keyframes spin {
            from {
                transform: rotate(0deg);
            }
            to {
                transform: rotate(360deg);
            }
        }

        .loading-text {
            margin-top: 20px;
            font-size: 18px;
            color: #555;
        }

        .file-size {
            margin-top: 10px;
            font-size: 16px;
            color: #888;
        }
    </style>
</head>
<body>
    <div class="loading-container">
        <div class="spinner"></div>
        <div class="loading-text">변환 중...</div>
        <div class="file-size">File size: 12.5 MB / 552.09MB</div>
    </div>
</body>
</html>